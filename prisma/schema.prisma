generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String                @id @default(cuid())
  name           String?
  email          String?               @unique
  emailVerified  DateTime?
  image          String?
  createdAt      DateTime              @default(now())
  password       String?
  role           String                @default("user")
  bannedAt       DateTime?
  bannedReason   String?
  accounts       Account[]
  sessions       Session[]
  weddings       Wedding[]
  collaborations WeddingCollaborator[]
  sentInvites    WeddingInvite[]
}

model WeddingInvite {
  id        String   @id @default(cuid())
  weddingId String
  inviterId String
  token     String   @unique
  role      String   @default("viewer")
  status    String   @default("pending")
  expiresAt DateTime
  createdAt DateTime @default(now())
  inviter   User     @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  wedding   Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
}

model WeddingCollaborator {
  id        String   @id @default(cuid())
  weddingId String
  userId    String
  role      String   @default("viewer")
  invitedBy String
  status    String   @default("accepted")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wedding   Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@unique([weddingId, userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Wedding {
  id              String                @id @default(cuid())
  userId          String
  name            String                @default("")
  religion        String                @default("")
  region          String                @default("")
  weddingDate     DateTime?
  weddingCity     String                @default("")
  selectedEvents  String                @default("[]")
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  budget          Int                   @default(0)
  guestCount      Int                   @default(0)
  weddingDays     Int                   @default(1)
  rsvpToken       String                @default("")
  aiMessages      AiMessage[]
  budgetItems     BudgetItem[]
  guests          Guest[]
  roomAllocations RoomAllocation[]
  seatingTables   SeatingTable[]
  tasks           Task[]
  vendors         Vendor[]
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  collaborators   WeddingCollaborator[]
  events          WeddingEvent[]
  invites         WeddingInvite[]
  timelineItems   WeddingTimelineItem[]
}

model RoomAllocation {
  id         String   @id @default(cuid())
  weddingId  String
  guestName  String   @default("")
  hotel      String   @default("")
  roomNumber String   @default("")
  roomType   String   @default("Standard")
  checkIn    String   @default("")
  checkOut   String   @default("")
  status     String   @default("Reserved")
  notes      String   @default("")
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  wedding    Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
}

model WeddingEvent {
  id             String   @id @default(cuid())
  weddingId      String
  name           String
  description    String   @default("")
  date           String   @default("")
  startTime      String   @default("10:00")
  duration       Int      @default(60)
  location       String   @default("")
  isRitual       Boolean  @default(false)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  isSimultaneous Boolean  @default(false)
  wedding        Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
}

model WeddingTimelineItem {
  id             String   @id @default(cuid())
  weddingId      String
  title          String
  description    String   @default("")
  startTime      String   @default("09:00")
  duration       Int      @default(30)
  isHighlight    Boolean  @default(false)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  isSimultaneous Boolean  @default(false)
  wedding        Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
}

model BudgetItem {
  id        String  @id @default(cuid())
  weddingId String
  category  String  @default("")
  item      String  @default("")
  estimated Int     @default(0)
  actual    Int     @default(0)
  paid      Int     @default(0)
  balance   Int     @default(0)
  status    String  @default("Pending")
  dueDate   String  @default("")
  notes     String  @default("")
  order     Int     @default(0)
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
}

model Vendor {
  id        String  @id @default(cuid())
  weddingId String
  category  String  @default("")
  name      String  @default("")
  contact   String  @default("")
  quote     Int     @default(0)
  paid      Int     @default(0)
  balance   Int     @default(0)
  rating    String  @default("")
  contract  String  @default("Pending")
  notes     String  @default("")
  order     Int     @default(0)
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
}

model Guest {
  id             String  @id @default(cuid())
  weddingId      String
  name           String  @default("")
  relation       String  @default("")
  side           String  @default("")
  rsvp           String  @default("Pending")
  dietary        String  @default("Veg")
  tableNum       Int     @default(0)
  giftGiven      String  @default("No")
  thankYou       String  @default("No")
  accommodation  String  @default("--")
  notes          String  @default("")
  order          Int     @default(0)
  wedding        Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
}

model Task {
  id        String  @id @default(cuid())
  weddingId String
  period    String  @default("")
  text      String  @default("")
  done      Boolean @default(false)
  order     Int     @default(0)
  dueDate   String  @default("")
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
}

model SeatingTable {
  id        String  @id @default(cuid())
  weddingId String
  name      String  @default("")
  capacity  Int     @default(8)
  guests    String  @default("[]")
  order     Int     @default(0)
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
}

model AiMessage {
  id          String   @id @default(cuid())
  weddingId   String
  role        String   @default("user")
  content     String   @default("")
  createdAt   DateTime @default(now())
  correctedTo String?
  intent      String?
  pattern     String?
  successful  Boolean?
  targetType  String?
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
}

model AiUsage {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId, date])
}
