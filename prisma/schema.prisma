generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String                @id @default(cuid())
  name           String?
  email          String?               @unique
  emailVerified  DateTime?
  image          String?
  createdAt      DateTime              @default(now())
  password       String?
  role           String                @default("user")
  plan           String                @default("free")
  bannedAt       DateTime?
  bannedReason   String?
  accounts       Account[]
  sessions       Session[]
  weddings       Wedding[]
  collaborations WeddingCollaborator[]
  sentInvites    WeddingInvite[]
}

model WeddingInvite {
  id        String   @id @default(cuid())
  weddingId String
  inviterId String
  token     String   @unique
  role      String   @default("viewer")
  status    String   @default("pending")
  expiresAt DateTime
  createdAt DateTime @default(now())
  inviter   User     @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  wedding   Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
}

model WeddingCollaborator {
  id        String   @id @default(cuid())
  weddingId String
  userId    String
  role      String   @default("viewer")
  invitedBy String
  status    String   @default("accepted")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wedding   Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@unique([weddingId, userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Wedding {
  id              String                @id @default(cuid())
  userId          String
  name            String                @default("")
  partner1Name    String                @default("")
  partner2Name    String                @default("")
  religion        String                @default("")
  region          String                @default("")
  country         String                @default("india")
  currency        String                @default("INR")
  dietaryDefault  String                @default("mixed")
  weddingDate     DateTime?
  weddingCity     String                @default("")
  selectedEvents  String                @default("[]")
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  budget          Int                   @default(0)
  guestCount      Int                   @default(0)
  weddingDays     Int                   @default(1)
  rsvpToken       String                @default("")
  websiteSlug     String                @default("")
  websiteConfig   String                @default("{}")
  aiMessages      AiMessage[]
  budgetItems     BudgetItem[]
  guests          Guest[]
  roomAllocations RoomAllocation[]
  seatingTables   SeatingTable[]
  tasks           Task[]
  vendors         Vendor[]
  gifts           Gift[]
  outfits         Outfit[]
  inviteDetails   InviteDetail[]
  checklistItems  ChecklistItem[]
  hashtags        Hashtag[]
  sangeetSongs    SangeetSong[]
  sangeetPractices SangeetPractice[]
  colorThemes     EventColorTheme[]
  outfitColors    OutfitColor[]
  familyMembers   FamilyMember[]
  familyRelationships FamilyRelationship[]
  seatingConflicts SeatingConflict[]
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  collaborators   WeddingCollaborator[]
  events          WeddingEvent[]
  invites         WeddingInvite[]
  timelineItems   WeddingTimelineItem[]
}

model RoomAllocation {
  id         String   @id @default(cuid())
  weddingId  String
  guestName  String   @default("")
  hotel      String   @default("")
  roomNumber String   @default("")
  roomType   String   @default("Standard")
  checkIn    String   @default("")
  checkOut   String   @default("")
  status     String   @default("Reserved")
  notes      String   @default("")
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  wedding    Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
}

model WeddingEvent {
  id             String   @id @default(cuid())
  weddingId      String
  name           String
  description    String   @default("")
  date           String   @default("")
  startTime      String   @default("10:00")
  duration       Int      @default(60)
  location       String   @default("")
  isRitual       Boolean  @default(false)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  isSimultaneous Boolean  @default(false)
  wedding        Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
}

model WeddingTimelineItem {
  id             String   @id @default(cuid())
  weddingId      String
  title          String
  description    String   @default("")
  startTime      String   @default("09:00")
  duration       Int      @default(30)
  isHighlight    Boolean  @default(false)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  isSimultaneous Boolean  @default(false)
  wedding        Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
}

model BudgetItem {
  id        String  @id @default(cuid())
  weddingId String
  category  String  @default("")
  item      String  @default("")
  estimated Int     @default(0)
  actual    Int     @default(0)
  paid      Int     @default(0)
  balance   Int     @default(0)
  status    String  @default("Pending")
  dueDate   String  @default("")
  notes     String  @default("")
  order     Int     @default(0)
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
}

model Vendor {
  id        String  @id @default(cuid())
  weddingId String
  category  String  @default("")
  name      String  @default("")
  contact   String  @default("")
  quote     Int     @default(0)
  paid      Int     @default(0)
  balance   Int     @default(0)
  rating    String  @default("")
  contract  String  @default("Pending")
  deadline  String  @default("")
  notes     String  @default("")
  order     Int     @default(0)
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
}

model Guest {
  id             String  @id @default(cuid())
  weddingId      String
  name           String  @default("")
  relation       String  @default("")
  side           String  @default("")
  rsvp           String  @default("Pending")
  dietary        String  @default("Veg")
  tableNum       Int     @default(0)
  giftGiven      String  @default("No")
  thankYou       String  @default("No")
  accommodation  String  @default("--")
  notes          String  @default("")
  order          Int     @default(0)
  wedding        Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
}

model Task {
  id        String  @id @default(cuid())
  weddingId String
  period    String  @default("")
  text      String  @default("")
  done      Boolean @default(false)
  order     Int     @default(0)
  dueDate   String  @default("")
  priority  String  @default("Medium")
  category  String  @default("")
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
}

model SeatingTable {
  id        String  @id @default(cuid())
  weddingId String
  name      String  @default("")
  capacity  Int     @default(8)
  guests    String  @default("[]")
  order     Int     @default(0)
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
}

model AiMessage {
  id          String   @id @default(cuid())
  weddingId   String
  role        String   @default("user")
  content     String   @default("")
  createdAt   DateTime @default(now())
  correctedTo String?
  intent      String?
  pattern     String?
  successful  Boolean?
  targetType  String?
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
}

model AiUsage {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model Gift {
  id        String  @id @default(cuid())
  weddingId String
  fromName  String  @default("")
  fromSide  String  @default("Both")
  amount    Int     @default(0)
  giftType  String  @default("Cash")
  received  String  @default("Yes")
  thankYou  String  @default("Pending")
  notes     String  @default("")
  order     Int     @default(0)
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
}

model Outfit {
  id             String  @id @default(cuid())
  weddingId      String
  event          String  @default("")
  person         String  @default("Bride")
  description    String  @default("")
  designer       String  @default("")
  status         String  @default("Shopping")
  cost           Int     @default(0)
  jewelryPairing String  @default("")
  notes          String  @default("")
  order          Int     @default(0)
  wedding        Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
}

model InviteDetail {
  id           String  @id @default(cuid())
  weddingId    String
  type         String  @default("Main Invite")
  description  String  @default("")
  designer     String  @default("")
  printer      String  @default("")
  quantity     Int     @default(0)
  cost         Int     @default(0)
  sentDate     String  @default("")
  rsvpDeadline String  @default("")
  status       String  @default("Planning")
  notes        String  @default("")
  order        Int     @default(0)
  wedding      Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
}

model ChecklistItem {
  id         String  @id @default(cuid())
  weddingId  String
  category   String  @default("Emergency Kit")
  text       String  @default("")
  done       Boolean @default(false)
  order      Int     @default(0)
  wedding    Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
}

model Hashtag {
  id         String  @id @default(cuid())
  weddingId  String
  text       String  @default("")
  language   String  @default("English")
  style      String  @default("Romantic")
  favorite   Boolean @default(false)
  order      Int     @default(0)
  wedding    Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
}

model WeddingTemplate {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  country        String
  religion       String
  region         String
  events         String   @default("[]")
  budgetRanges   String   @default("{}")
  dressCodes     String   @default("{}")
  foodDefaults   String   @default("{}")
  checklistItems String   @default("[]")
  guestRange     String   @default("{}")
  planningMonths Int      @default(12)
  currency       String   @default("INR")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SangeetSong {
  id            String              @id @default(cuid())
  weddingId     String
  title         String              @default("")
  artist        String              @default("")
  duration      Int                 @default(0)
  type          String              @default("Group")
  event         String              @default("Sangeet")
  notes         String              @default("")
  musicUrl      String              @default("")
  musicPlatform String              @default("")
  order         Int                 @default(0)
  createdAt     DateTime            @default(now())
  wedding       Wedding             @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  performances  SangeetPerformance[]
}

model SangeetPerformance {
  id            String      @id @default(cuid())
  songId        String
  personName    String      @default("")
  role          String      @default("Performer")
  confirmed     Boolean     @default(false)
  notes         String      @default("")
  order         Int         @default(0)
  createdAt     DateTime    @default(now())
  song          SangeetSong @relation(fields: [songId], references: [id], onDelete: Cascade)
}

model SangeetPractice {
  id            String   @id @default(cuid())
  weddingId     String
  date          String   @default("")
  time          String   @default("")
  location      String   @default("")
  notes         String   @default("")
  attendees     String   @default("[]")
  completed     Boolean  @default(false)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  wedding       Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
}

model EventColorTheme {
  id             String   @id @default(cuid())
  weddingId      String
  eventName      String   @default("")
  primaryColor   String   @default("#000000")
  secondaryColor String   @default("")
  accentColor    String   @default("")
  mood           String   @default("")
  notes          String   @default("")
  createdAt      DateTime @default(now())
  wedding        Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
}

model OutfitColor {
  id             String   @id @default(cuid())
  weddingId      String
  eventName      String   @default("")
  person         String   @default("")
  outfitDesc     String   @default("")
  primaryColor   String   @default("")
  secondaryColor String   @default("")
  accentColor    String   @default("")
  matchScore     Int      @default(0)
  notes          String   @default("")
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  wedding        Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
}

model FamilyMember {
  id            String              @id @default(cuid())
  weddingId     String
  name          String              @default("")
  side          String              @default("Bride")
  relation      String              @default("")
  age           Int                 @default(0)
  sideDetail    String              @default("")
  notes         String              @default("")
  order         Int                 @default(0)
  createdAt     DateTime            @default(now())
  wedding       Wedding             @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  relationshipsA FamilyRelationship[] @relation("MemberA")
  relationshipsB FamilyRelationship[] @relation("MemberB")
}

model FamilyRelationship {
  id            String       @id @default(cuid())
  weddingId     String
  memberIdA     String
  memberIdB     String
  status        String       @default("Good")
  notes         String       @default("")
  conflictLevel Int          @default(0)
  createdAt     DateTime     @default(now())
  wedding       Wedding      @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  memberA       FamilyMember @relation("MemberA", fields: [memberIdA], references: [id], onDelete: Cascade)
  memberB       FamilyMember @relation("MemberB", fields: [memberIdB], references: [id], onDelete: Cascade)
}

model SeatingConflict {
  id            String   @id @default(cuid())
  weddingId     String
  guestName     String   @default("")
  conflictWith  String   @default("")
  severity      String   @default("Medium")
  reason        String   @default("")
  resolved      Boolean  @default(false)
  notes         String   @default("")
  createdAt     DateTime @default(now())
  wedding       Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
}


